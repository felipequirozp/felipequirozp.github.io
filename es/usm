<style>
:root{
  --navy:#182536;--navy-deep:#0d1724;--steel:#324963;--steel-light:#71869c;
  --slate:#9aa9ba;--slate-light:#c7d0d9;--ice:#eef1f4;--paper:#f5f6f7;
  --white:#fff;--ink:#10161d;--muted:#66717d;--line:#d4d9de;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,Arial,sans-serif}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
header{
  position:sticky;top:0;z-index:1000;background:rgba(13,23,36,.94);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid rgba(255,255,255,.06)
}
.nav{max-width:1240px;margin:auto;padding:18px 28px;display:flex;align-items:center;justify-content:space-between}
.brand{font-family:Manrope,Arial,sans-serif;font-weight:700;color:white;letter-spacing:-.02em}
.nav-links{display:flex;align-items:center;gap:24px;color:var(--slate-light);font-size:13px}
.nav-links a:hover{color:white}
.contact-pill{border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:10px 15px}
.lang-switch{
  width:38px;height:38px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  border:1px solid rgba(255,255,255,.22);border-radius:50%;color:var(--slate-light)!important;
  font-size:9px;font-weight:600;letter-spacing:.06em
}
.lang-switch:hover{background:rgba(255,255,255,.10);color:white!important;border-color:rgba(255,255,255,.45)}
.hero{background:var(--navy-deep);color:white;padding:96px 28px 110px}
.wrap{max-width:1240px;margin:auto}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate-light);margin-bottom:22px}
.hero h1{font-family:Manrope,Arial,sans-serif;font-size:clamp(52px,8vw,92px);line-height:.98;letter-spacing:-.055em;margin:0;max-width:1050px}
.hero p{max-width:760px;color:#c7d0d9;font-size:20px;line-height:1.55;margin:34px 0 0}
.meta{display:flex;gap:40px;flex-wrap:wrap;margin-top:46px;color:var(--slate-light);font-size:13px}
.meta strong{color:white;font-weight:600}
section{padding:92px 28px;border-bottom:1px solid var(--line)}
.section-grid{display:grid;grid-template-columns:180px 1fr;gap:54px}
.num{font-size:11px;letter-spacing:.14em;color:var(--steel-light);text-transform:uppercase}
.section-title{font-family:Manrope,Arial,sans-serif;font-size:clamp(38px,5vw,62px);line-height:1.05;letter-spacing:-.045em;margin:0 0 26px;max-width:880px}
.lead{font-size:20px;line-height:1.65;color:var(--steel);max-width:860px}
.body{font-size:16px;line-height:1.75;color:var(--muted);max-width:860px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);margin-top:40px}
.metric{padding:34px;border-right:1px solid var(--line)}
.metric:last-child{border-right:0}
.metric strong{display:block;font-family:Manrope,Arial,sans-serif;font-size:42px;letter-spacing:-.05em;color:var(--navy)}
.metric span{display:block;margin-top:8px;color:var(--muted);font-size:13px}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:34px}
.card{background:white;border:1px solid var(--line);border-radius:18px;padding:32px}
.card .tag{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel-light);margin-bottom:16px}
.card h3{font-family:Manrope,Arial,sans-serif;font-size:30px;line-height:1.1;letter-spacing:-.035em;margin:0 0 16px}
.card p{color:var(--muted);line-height:1.7;margin:0}
.bullets{margin:22px 0 0;padding:0;list-style:none}
.bullets li{padding:12px 0;border-top:1px solid var(--line);color:var(--steel)}
.quote{background:var(--navy);color:white;border:0}
.quote .tag{color:var(--slate-light)}
.quote h3{font-size:38px}
.quote p{color:var(--slate-light)}
.cta{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;padding:12px 16px;margin-top:26px;font-size:13px;background:white}
.cta:hover{border-color:var(--steel-light)}
footer{background:var(--navy-deep);color:var(--slate-light);padding:30px 28px}
.footer{max-width:1240px;margin:auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;font-size:12px}
.socials{display:flex;gap:10px}
.socials a{width:34px;height:34px;border:1px solid rgba(255,255,255,.16);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:11px}
.place{text-align:right}

.editorial-photo{margin-top:34px}
.editorial-photo img{width:100%;height:auto;object-fit:cover;border-radius:18px}
.editorial-photo figcaption{margin-top:12px;color:var(--muted);font-size:12px;line-height:1.5}
.editorial-split{display:grid;grid-template-columns:1.45fr .75fr;gap:24px;align-items:end;margin-top:34px}
.editorial-split .secondary img{aspect-ratio:4/5;object-fit:cover}
@media(max-width:820px){
  .editorial-split{grid-template-columns:1fr}
  .editorial-split .secondary img{aspect-ratio:auto}
}

@media(max-width:820px){
  .section-grid{grid-template-columns:1fr;gap:24px}
  .metrics{grid-template-columns:1fr 1fr}
  .metric:nth-child(2){border-right:0}
  .metric:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .cards{grid-template-columns:1fr}
}
@media(max-width:600px){
  .nav{padding:14px 18px;align-items:flex-start;gap:12px}
  .nav-links{gap:10px;flex-wrap:wrap;justify-content:flex-end;font-size:11px}
  .contact-pill{padding:8px 10px}
  .lang-switch{width:34px;height:34px;font-size:8px}
  .hero{padding:70px 20px 82px}
  .hero p{font-size:18px}
  section{padding:68px 20px}
  .metrics{grid-template-columns:1fr}
  .metric{border-right:0!important;border-bottom:1px solid var(--line)}
  .metric:last-child{border-bottom:0}
  .footer{grid-template-columns:1fr;gap:18px;text-align:center}
  .place{text-align:center}
}
</style>
